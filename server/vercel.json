{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    }
  ],
  "environment": {
    "FLUX_API_KEY": "@flux_api_key",
    "GOOGLE_API_KEY": "@google_api_key",
    "FRONTEND_URL": "@frontend_url"
  }
}